{
  "version": 2,
  "builds": [
    {
      "src": "src/app.js",
      "use": "@vercel/node"
    },
    {
      "src": "src/style.css",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/src/style.css",
      "dest": "src/style.css"
    },
    {
      "src": "/api/(.*)",
      "dest": "src/app.js"
    },
    {
      "src": "/(.*)",
      "dest": "src/app.js"
    }
  ]
}
